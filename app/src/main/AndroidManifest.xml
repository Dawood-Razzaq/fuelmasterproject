<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FuelMasterProject">

        <!-- Login Activity (Launcher) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Signup Activity -->
        <activity
            android:name=".SignupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Dashboard Activity -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- My Shift Activity -->
        <activity
            android:name=".MyShiftActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Fuel Inventory Activity -->
        <activity
            android:name=".FuelInventoryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tank Management Activity -->
        <activity
            android:name=".TankManagementActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pump & Nozzle Activity -->
        <activity
            android:name=".PumpNozzleActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Shift Reconciliation Activity -->
        <activity
            android:name=".ShiftReconciliationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Employee Management Activity -->
        <activity
            android:name=".EmployeeManagementActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Attendance Activity -->
        <activity
            android:name=".AttendanceActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- CRM Activity -->
        <activity
            android:name=".CrmActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Supplier Management Activity -->
        <activity
            android:name=".SupplierManagementActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Purchase Management Activity -->
        <activity
            android:name=".PurchaseManagementActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Expense Management Activity -->
        <activity
            android:name=".ExpenseManagementActivity"
